rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-All: Deny by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'YG8glv1gg4XXYUkSUMZtyBcT1fu2' ||
        request.auth.token.email == 'mrs.engineers.bd26@gmail.com' ||
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) 
        && request.resource.data.uid == userId
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'user');
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phoneNumber', 'photoURL', 'bio', 'skills', 'activeRole', 'updatedAt'
        ])
        || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Admins Reference Collection ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Connection Test Document ---
    match /test/{testId} {
      allow read: if true;
    }

    // --- Categories Collection ---
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Jobs Collection ---
    match /jobs/{jobId} {
      allow read: if true;
      allow list: if true;
      allow create: if isSignedIn() 
        && request.resource.data.clientId == request.auth.uid
        && isValidId(jobId);
      allow update: if (
        isSignedIn() && resource.data.clientId == request.auth.uid 
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'instructions', 'status', 'workersCompleted', 'updatedAt'
        ])
      ) || isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid && resource.data.status == 'draft');
    }

    // --- Submissions Collection ---
    match /submissions/{submissionId} {
      allow get: if isSignedIn() && (
        resource.data.freelancerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.freelancerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() 
        && request.resource.data.freelancerId == request.auth.uid
        && isValidId(submissionId);
      allow update: if isSignedIn() && (
        // Client can review/approve/reject/request revision
        (resource.data.clientId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'rejectionReason', 'revisionNotes', 'reviewedAt'
        ])) ||
        // Freelancer can resubmit on revision
        (resource.data.freelancerId == request.auth.uid && resource.data.status == 'revision_requested' && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'proofAnswers', 'status', 'submittedAt'
        ])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // --- Job Conversations & Messages ---
    match /jobConversations/{conversationId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.freelancerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.freelancerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.clientId == request.auth.uid ||
        request.resource.data.freelancerId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.freelancerId == request.auth.uid ||
        isAdmin()
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/jobConversations/$(conversationId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/jobConversations/$(conversationId)).data.freelancerId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isSignedIn() 
          && request.resource.data.senderId == request.auth.uid
          && (
            get(/databases/$(database)/documents/jobConversations/$(conversationId)).data.clientId == request.auth.uid ||
            get(/databases/$(database)/documents/jobConversations/$(conversationId)).data.freelancerId == request.auth.uid ||
            isAdmin()
          );
      }
    }

    // --- Dual Wallets Collection ---
    match /wallets/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // Wallets can only be initialized on user registration with zero balances or by admin
      allow create: if (
        isOwner(userId) &&
        request.resource.data.clientDepositBalance == 0 &&
        request.resource.data.freelancerEarningsBalance == 0 &&
        request.resource.data.lockedInWithdrawal == 0 &&
        request.resource.data.totalDeposited == 0 &&
        request.resource.data.totalEarned == 0
      ) || isAdmin();
      // Users can NEVER inflate their balance or modify total records. Only admin can credit deposits/approve payouts.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.totalDeposited == resource.data.totalDeposited &&
        request.resource.data.totalEarned == resource.data.totalEarned &&
        request.resource.data.clientDepositBalance <= resource.data.clientDepositBalance
      );
      allow delete: if isAdmin();
    }

    // --- Wallet Transactions Ledger ---
    match /walletTransactions/{txId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false; // Immutable ledger
    }

    // --- Deposit Requests ---
    match /depositRequests/{requestId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Withdrawal Requests ---
    match /withdrawalRequests/{requestId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // --- Contact Messages ---
    match /contactMessages/{messageId} {
      allow create: if true; // Public contact form
      allow read, update, delete: if isAdmin();
    }

    // --- Platform Settings ---
    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Audit Logs ---
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit log
    }
  }
}
